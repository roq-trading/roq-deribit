{
  "name": "Common",
  "type": "flags",
  "values": [
    {
      "name": "request_limit",
      "type": "uint32_t",
      "default": "20",
      "description": "request limit per interval"
    },
    {
      "name": "request_limit_interval",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "1s",
      "description": "request limit monitor interval"
    },
    {
      "name": "encode_buffer_size",
      "type": "uint32_t",
      "required": true,
      "default": 1048576,
      "description": "encode buffer size"
    },
    {
      "name": "decode_buffer_size",
      "type": "uint32_t",
      "required": true,
      "default": 10485760,
      "description": "decode buffer size"
    },
    {
      "name": "disable_deribit_143",
      "type": "bool",
      "default": false,
      "description": "disable #143"
    },
    {
      "name": "disable_master_account_check",
      "type": "bool",
      "default": false,
      "description": "disable requirement for master account"
    },
    {
      "name": "mbp_allow_price_inversion",
      "type": "bool",
      "default": true,
      "description": "allow price inversion?"
    },
    {
      "name": "local_interface",
      "type": "std::string",
      "description": "Multicast local interface",
      "comment": "ONLY HERE BECAUSE OF multicast_ PREFIX"
    },
    {
      "name": "download_trades_lookback",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "{}",
      "description": "download trades lookback period"
    },
    {
      "name": "download_trades_count",
      "type": "uint32_t",
      "default": 0,
      "description": "download trades count"
    }
  ]
}
