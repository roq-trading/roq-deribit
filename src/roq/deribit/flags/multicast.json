{
  "name": "roq/deribit/flags/Multicast",
  "type": "flags",
  "prefix": "multicast_",
  "values": [
    {
      "name": "address",
      "type": "std/string",
      "array": "std/vector",
      "default": [
        "239.111.111.1",
        "239.111.111.3"
      ],
      "description": "List of multicast addresses (comma-separated)"
    },
    {
      "name": "port_events",
      "type": "std/uint16",
      "default": "6100",
      "description": "Multicast port used for events"
    },
    {
      "name": "port_snapshot",
      "type": "std/uint16",
      "default": "6101",
      "description": "Multicast port for snapshot"
    },
    {
      "name": "disable_top_of_book",
      "type": "std/bool",
      "description": "Default is to consume TopOfBook from the multicast feed"
    },
    {
      "name": "disable_trade_summary",
      "type": "std/bool",
      "description": "Default is to consume TradeSummary from the multicast feed"
    },
    {
      "name": "disable_market_by_price",
      "type": "std/bool",
      "description": "Default is to consume MarketByPrice from the multicast feed"
    },
    {
      "name": "timeout",
      "type": "std/nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "90s",
      "description": "Timeout when waiting for snapshot"
    }
  ]
}
