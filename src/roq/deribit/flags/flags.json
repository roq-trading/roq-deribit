{
  "name": "Flags",
  "type": "flags",
  "values": [
    {
      "name": "config_file",
      "type": "std::string",
      "validator": "roq::core::flags::Path<std::string>",
      "description": "config file (path)"
    },
    {
      "name": "exchange",
      "type": "std::string",
      "validator": "roq::core::flags::NonEmpty<std::string>",
      "default": "deribit",
      "description": "exchange identifier (string)"
    },
    {
      "name": "ws_uri",
      "type": "roq::core::URI",
      "validator": "roq::core::flags::URI<std::string>",
      "default": "wss://test.deribit.com/ws/api/v2",
      "description": "WebSocket end-point (URI)"
    },
    {
      "name": "ws_ping_freq",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::core::flags::TimePeriod",
      "default": "5s",
      "description": "ping frequency"
    },
    {
      "name": "ws_request_timeout",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::core::flags::TimePeriod",
      "default": "15s",
      "description": "request timeout"
    },
    {
      "name": "ws_market_data_max_subscriptions_per_stream",
      "type": "uint32_t",
      "validator": "roq::core::flags::NonZero<uint32_t>",
      "default": 256,
      "description": "max subscriptions per connection (count)"
    },
    {
      "name": "ws_max_trades",
      "type": "uint32_t",
      "validator": "roq::core::flags::NonZero<uint32_t>",
      "default": 100,
      "description": "max number of trades for historical lookup (count)"
    },
    {
      "name": "fix_uri",
      "type": "roq::core::URI",
      "validator": "roq::core::flags::URI<std::string>",
      "default": "tcp://test.deribit.com:9881",
      "description": "FIX end-point (URI)"
    },
    {
      "name": "fix_ping_freq",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::core::flags::TimePeriod",
      "default": "5s",
      "description": "ping frequency"
    },
    {
      "name": "fix_request_timeout",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::core::flags::TimePeriod",
      "default": "15s",
      "description": "request timeout"
    },
    {
      "name": "fix_cancel_on_disconnect",
      "type": "bool",
      "default": true,
      "description": "cancel orders on disconnect? (bool)"
    },
    {
      "name": "fix_market_data_max_subscriptions_per_stream",
      "type": "uint32_t",
      "validator": "roq::core::flags::NonZero<uint32_t>",
      "default": 256,
      "description": "max subscriptions per connection (count)"
    },
    {
      "name": "fix_market_data_request_max_size",
      "type": "uint32_t",
      "default": 56,
      "description": "max batch size (it appears there is a limit)"
    },
    {
      "name": "fix_market_data_market_depth",
      "type": "uint32_t",
      "default": 20,
      "description": "market depth (see deribit documentation)"
    },
    {
      "name": "fix_debug",
      "type": "bool",
      "default": false,
      "description": "log fix messages?"
    },
    {
      "name": "encode_buffer_size",
      "type": "uint32_t",
      "validator": "roq::core::flags::NonZero<uint32_t>",
      "default": 1048576,
      "description": "encode buffer size"
    },
    {
      "name": "decode_buffer_size",
      "type": "uint32_t",
      "validator": "roq::core::flags::NonZero<uint32_t>",
      "default": 10485760,
      "description": "decode buffer size"
    }
  ]
