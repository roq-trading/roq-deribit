{
  "name": "roq/deribit/flags/WS",
  "type": "flags",
  "prefix": "ws_",
  "values": [
    {
      "name": "uri",
      "type": "roq/io/web/URI",
      "validator": "roq/core/flags/URI",
      "default": "wss://test.deribit.com/ws/api/v2",
      "required": true,
      "description": "Exchange end-point"
    },
    {
      "name": "host",
      "type": "std/string",
      "description": "Host (when URI is an IP address)"
    },
    {
      "name": "ping_freq",
      "type": "std/nanoseconds",
      "validator": "roq/flags/validators/TimePeriod",
      "default": "5s",
      "description": "Ping frequency"
    },
    {
      "name": "request_timeout",
      "type": "std/nanoseconds",
      "validator": "roq/flags/validators/TimePeriod",
      "default": "15s",
      "description": "Request timeout"
    },
    {
      "name": "market_data_max_subscriptions_per_stream",
      "type": "std/uint32",
      "required": true,
      "default": 256,
      "description": "Maximum number of symbols per connection"
    },
    {
      "name": "ticker_interval",
      "type": "std/string",
      "default": "100ms",
      "required": true,
      "description": "Ticker interval"
    },
    {
      "name": "allow_errors",
      "type": "std/bool",
      "description": "(TEST) Allow errors"
    },
    {
      "name": "disable_quote",
      "type": "std/bool",
      "description": "Disable quote subscription"
    }
  ]
}
