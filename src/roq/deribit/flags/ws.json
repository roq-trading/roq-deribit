{
  "name": "WS",
  "type": "flags",
  "prefix": "ws_",
  "values": [
    {
      "name": "uri",
      "type": "roq::io::web::URI",
      "validator": "roq::core::flags::URI",
      "default": "wss://test.deribit.com/ws/api/v2",
      "required": true,
      "description": "WebSocket end-point (URI)"
    },
    {
      "name": "host",
      "type": "std::string",
      "description": "Host (http header) in case uri uses an IP address"
    },
    {
      "name": "ping_freq",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "5s",
      "description": "Ping frequency"
    },
    {
      "name": "request_timeout",
      "type": "std::chrono::nanoseconds",
      "validator": "roq::flags::validators::TimePeriod",
      "default": "15s",
      "description": "Request timeout"
    },
    {
      "name": "market_data_max_subscriptions_per_stream",
      "type": "uint32_t",
      "required": true,
      "default": 256,
      "description": "Max subscriptions per connection (count)"
    },
    {
      "name": "ticker_interval",
      "type": "std::string",
      "default": "100ms",
      "required": true,
      "description": "Ticker interval"
    },
    {
      "name": "allow_errors",
      "type": "bool",
      "description": "Allow errors (debug)"
    },
    {
      "name": "disable_quote",
      "type": "bool",
      "description": "Disable quote subscription"
    }
  ]
}
